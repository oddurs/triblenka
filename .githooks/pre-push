#!/bin/sh
# The default branch only ever advances through a merged pull request.
set -eu

cd "$(git rev-parse --show-toplevel)"

default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || echo main)

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
	"refs/heads/$default")
		echo "pre-push: refusing to push to '$default'" >&2
		echo "  open a pull request instead: scripts/agent start <type>/<slug>" >&2
		exit 1
		;;
	esac
done

scripts/task check
