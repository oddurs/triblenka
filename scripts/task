#!/bin/sh
# The one interface between this project and all of its automation.
#
# CI, git hooks and scripts/agent call these targets and nothing else, so the
# toolchain can change without touching a workflow or a hook.
set -eu

usage() {
	cat <<'USAGE'
usage: scripts/task <target>

  fmt        format in place
  fmt:check  verify formatting, non-zero on drift
  lint       lint; warnings are errors
  test       full test suite
  build      compile everything
  check      fmt:check && lint && test && build
USAGE
}

# The backlog is part of the project's correctness, but cairn is not a published
# crate yet, so it is checked only where it is installed rather than being made a
# hard prerequisite for contributors and CI.
backlog_check() {
	if [ ! -f cairn.toml ]; then
		return 0
	fi
	if command -v cairn >/dev/null 2>&1; then
		echo "==> cairn check"
		cairn check
	else
		echo "==> cairn check: skipped, cairn is not installed (see CONTRIBUTING.md)"
	fi
}

case "${1:-}" in
fmt)
	echo "==> cargo fmt"
	cargo fmt --all
	;;
fmt:check)
	echo "==> cargo fmt --check"
	cargo fmt --all -- --check
	;;
lint)
	echo "==> cargo clippy"
	cargo clippy --workspace --all-targets --all-features -- -D warnings
	;;
test)
	echo "==> cargo test"
	cargo test --workspace --all-features
	;;
build)
	echo "==> cargo build"
	cargo build --workspace --all-features
	;;
check)
	"$0" fmt:check
	"$0" lint
	"$0" test
	"$0" build
	backlog_check
	echo "==> ok"
	;;
-h | --help | help | "")
	usage
	;;
*)
	echo "task: unknown target '$1'" >&2
	usage >&2
	exit 2
	;;
esac
